# Names only. Copy to .env and fill in. Never commit .env (SEC-003).
# Values in brackets are the SRS/SAD defaults where they exist.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
FRONTEND_ORIGIN=
# open SRS values (TBD-C12): keep in config, not code
MAX_SMILES_LEN=
PARSE_TIMEOUT_S=
TASK_MAX_RETRIES=
ML_SOFT_LIMIT_S=
ML_HARD_LIMIT_S=
DL_SOFT_LIMIT_S=
DL_HARD_LIMIT_S=
QML_SOFT_LIMIT_S=
QML_HARD_LIMIT_S=
SESSION_IDLE_MIN=
MAX_FAILED_LOGINS=
LOCKOUT_MIN=
RATE_LIMIT=
# limits fixed by the SRS: PubChem 5 requests/s (FR-055), cache 24 h (FR-055), QML concurrency 1 or 2 (NFR-013)
PUBCHEM_RPS=
CACHE_TTL_HOURS=
QML_CONCURRENCY=
# model-quality settings (TBD-C8, TBD-C6, TBD-C9)
AD_TANIMOTO_MIN=
QML_CONV_THRESHOLD_MHA=
TRIAGE_RULES_PATH=
TARGETS_PATH=
MODELS_DIR=
